# .importlinter — these contracts run in CI and fail the build on violation
[importlinter]
root_package = actl
include_external_packages = True

[importlinter:contract:1]
name = Domain is pure
type = forbidden
source_modules =
    actl.domain
forbidden_modules =
    actl.infrastructure
    actl.interfaces
    sqlalchemy
    httpx
    redis
    razorpay
    groq
    web3
    eth_account

[importlinter:contract:2]
name = Layers point inward
type = layers
layers =
    actl.interfaces
    actl.application
    actl.domain

[importlinter:contract:3]
name = Only the gate may reach a payment provider
type = forbidden
source_modules =
    actl.interfaces
    actl.domain
    actl.application.agents
    actl.application.conversation
forbidden_modules =
    actl.infrastructure.providers.razorpay

[importlinter:contract:4]
# §23.4 / §28 P6: the precise, native form of "only the gate may import the
# concrete Razorpay adapter" -- a `protected` contract checks the whole
# graph, not just an enumerated source-module list, so a *new* application
# module added later that imports the adapter breaks the build immediately
# rather than silently falling outside contract 3's list. The provider
# factory (infrastructure's own composition root, invoked only from
# actl.main/actl.cli/actl.worker -- see docs/adr/0006 decision 1 and
# docs/adr/0007) is the one legitimate non-application importer.
name = Only the gate (or the provider factory) may import the Razorpay adapter
type = protected
protected_modules =
    actl.infrastructure.providers.razorpay
allowed_importers =
    actl.application.gate
    actl.infrastructure.providers.factory

[importlinter:contract:5]
# §28 P8 instruction 1: "no direct Groq imports outside infrastructure."
# The domain half of this is already contract 1 (`groq` forbidden to
# actl.domain); this covers the other two layers the whole import graph
# can reach it from, mirroring contract 3's shape for the Razorpay
# adapter -- application/interfaces code depends only on the `LLMClient`
# port (application/ports.py), never on the groq SDK or the concrete
# GroqClient directly.
name = Only infrastructure may import groq
type = forbidden
source_modules =
    actl.interfaces
    actl.application
forbidden_modules =
    groq

[importlinter:contract:6]
# §28 P11: MonadAnchor is deliberately never wired into application.
# audit_service's synchronous `anchor=` parameter (that would block audit
# appends on Monad's availability, see docs/adr/0016) -- real anchoring
# runs from actl.worker's own async loop instead, which builds the
# adapter via infrastructure.anchor.factory directly, the same
# composition-root pattern contract 4 already establishes for the
# Razorpay adapter.
name = Only the worker (or the anchor factory) may import the Monad adapter
type = protected
protected_modules =
    actl.infrastructure.anchor.monad_testnet
allowed_importers =
    actl.worker
    actl.infrastructure.anchor.factory
