# .importlinter — these contracts run in CI and fail the build on violation
[importlinter]
root_package = actl
include_external_packages = True

[importlinter:contract:1]
name = Domain is pure
type = forbidden
source_modules =
    actl.domain
forbidden_modules =
    actl.infrastructure
    actl.interfaces
    sqlalchemy
    httpx
    redis
    razorpay
    groq

[importlinter:contract:2]
name = Layers point inward
type = layers
layers =
    actl.interfaces
    actl.application
    actl.domain

[importlinter:contract:3]
name = Only the gate may reach a payment provider
type = forbidden
source_modules =
    actl.interfaces
    actl.domain
    actl.application.agents
    actl.application.conversation
forbidden_modules =
    actl.infrastructure.providers.razorpay

[importlinter:contract:4]
# §23.4 / §28 P6: the precise, native form of "only the gate may import the
# concrete Razorpay adapter" -- a `protected` contract checks the whole
# graph, not just an enumerated source-module list, so a *new* application
# module added later that imports the adapter breaks the build immediately
# rather than silently falling outside contract 3's list. The provider
# factory (infrastructure's own composition root, invoked only from
# actl.main/actl.cli/actl.worker -- see docs/adr/0006 decision 1 and
# docs/adr/0007) is the one legitimate non-application importer.
name = Only the gate (or the provider factory) may import the Razorpay adapter
type = protected
protected_modules =
    actl.infrastructure.providers.razorpay
allowed_importers =
    actl.application.gate
    actl.infrastructure.providers.factory
